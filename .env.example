# BLACK VAVE CORPORATION website - environment configuration
# Copy this file to .env.local and fill in real values.

# Public site URL (used for canonical URLs, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://www.blackvave.com

# --- Analytics (Google Analytics 4 / Tag Manager) ---
# Leave empty to disable tracking. When set, scripts load from
# googletagmanager.com / google-analytics.com (allowed by the site CSP).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# --- Contact form email delivery ---
# The /api/contact endpoint validates and rate-limits submissions server-side.
# Email delivery uses a Resend-compatible API. When CONTACT_EMAIL_API_KEY is
# not set, submissions are accepted and logged server-side, and the form
# reports that email delivery is pending configuration (no email is sent).
CONTACT_EMAIL_API_KEY=
CONTACT_EMAIL_API_URL=https://api.resend.com/emails
CONTACT_RECIPIENT_EMAIL=contact@blackvave.com
CONTACT_EMAIL_FROM="Black Vave Website <noreply@blackvave.com>"
