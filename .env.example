# BLACK VAVE CORPORATION website - environment configuration
# Copy this file to .env.local and fill in real values.

# Public site URL (used for canonical URLs, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://www.blackvave.com

# --- Analytics (Google Analytics 4 / Tag Manager) ---
# Leave empty to disable tracking.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# --- Contact form (server-side endpoint) ---
# When a backend is provisioned, point the form to a secure API.
CONTACT_API_URL=
# Recipient email for contact enquiries
CONTACT_RECIPIENT_EMAIL=

# --- Server-side secrets (never expose in frontend) ---
# Secret for CSRF / form signing
FORM_SECRET=
